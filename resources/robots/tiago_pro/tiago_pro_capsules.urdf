  </link>
  <joint name="base_front_laser_joint" type="fixed">
    <origin xyz="0.27512 -0.18297 0.13244" rpy="-3.141592653589793 0.0 -0.7853981633974483"/>
    <axis xyz="0.0 1.0 0.0"/>
    <parent link="base_link"/>
    <child link="base_front_laser_link"/>
  </joint>
  <gazebo reference="base_front_laser_link"><sensor name="base_front_laser" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>scan_front_raw</topic>
      <gz_frame_id>base_front_laser_link</gz_frame_id>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <ray>
        <scan>
          <horizontal>
            <!-- 818 (270/0.33) steps in 270deg fov -->
            <samples>818.0</samples>
            <resolution>1</resolution>
            <!-- not the sensor resolution; just 1 -->
            <min_angle>-2.3387411976724017</min_angle>
            <!--there is a laserscan detecting ghost obstacle-->
            <max_angle>2.356194490192345</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>25.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="base_front_laser">
        <ros>
          <namespace/>
          <remapping>~/out:=scan_front_raw</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_front_laser_link</frame_name>
      </plugin>
    </sensor>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <joint name="virtual_base_laser_joint" type="fixed">
    <origin xyz="0.0 0.0 0.13244" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="virtual_base_laser_link"/>
  </joint>
  <link name="virtual_base_laser_link"/>
  <link name="base_imu_link"/>
  <joint name="base_imu_joint" type="fixed">
    <origin xyz="-0.287 0.0 0.092163" rpy="0.0 0.0 1.5707963267948966"/>
    <parent link="base_link"/>
    <child link="base_imu_link"/>
  </joint>
  <gazebo reference="base_imu_link"><sensor name="base_imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100.0</update_rate>
      <topic>base_imu</topic>
      <imu>
        <noise>
          <type>gaussian</type>
          <rate>
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
            <bias_mean>0.0000075</bias_mean>
            <bias_stddev>0.0000008</bias_stddev>
          </rate>
          <accel>
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
            <bias_mean>0.1</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </accel>
        </noise>
      </imu>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="base_imu">
        <ros>
          <namespace/>
          <!-- publish to /imu/data -->
          <remapping>~/out:=base_imu</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>
