  <link name="base_rear_laser_link">
    <inertial>
      <origin xyz="-0.02559 -0.00056 -0.05732" rpy="0.0 0.0 0.0"/>
      <mass value="0.28922"/>
      <inertia ixx="2.628919e-05" ixy="2.4298e-07" ixz="-3.68129e-06" iyy="3.374542e-05" iyz="-1.33e-08" izz="5.832599e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="tiago_pro_description/meshes/sick_tim551.stl"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.01" length="0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_rear_laser_joint" type="fixed">
    <origin xyz="-0.27512 0.18297 0.13244" rpy="-3.141592653589793 0.0 2.356194490192345"/>
    <axis xyz="0.0 1.0 0.0"/>
    <parent link="base_link"/>
    <child link="base_rear_laser_link"/>
  </joint>
  <gazebo reference="base_rear_laser_link"><sensor name="base_rear_laser" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>scan_rear_raw</topic>
      <gz_frame_id>base_rear_laser_link</gz_frame_id>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <ray>
        <scan>
          <horizontal>
            <!-- 818 (270/0.33) steps in 270deg fov -->
            <samples>818.0</samples>
            <resolution>1</resolution>
            <!-- not the sensor resolution; just 1 -->
            <min_angle>-2.3387411976724017</min_angle>
            <!--there is a laserscan detecting ghost obstacle-->
            <max_angle>2.356194490192345</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>25.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="base_rear_laser">
        <ros>
          <namespace/>
          <remapping>~/out:=scan_rear_raw</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_rear_laser_link</frame_name>
      </plugin>
    </sensor>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <link name="base_front_laser_link">
    <inertial>
      <origin xyz="-0.02559 -0.00056 -0.05732" rpy="0.0 0.0 0.0"/>
      <mass value="0.28922"/>
      <inertia ixx="2.628919e-05" ixy="2.4298e-07" ixz="-3.68129e-06" iyy="3.374542e-05" iyz="-1.33e-08" izz="5.832599e-05"/>
