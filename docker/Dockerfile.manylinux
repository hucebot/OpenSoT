FROM quay.io/pypa/manylinux_2_28_x86_64

SHELL ["/bin/bash", "-c"]

ENV TZ="Europe/Paris"
ENV PATH=/opt/rh/gcc-toolset-13/root/usr/bin:$PATH \
    LD_LIBRARY_PATH=/opt/rh/gcc-toolset-13/root/usr/lib64:/opt/deps/lib

ENV CMAKE_COMMON="-DCMAKE_INSTALL_PREFIX=/opt/deps -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_POSITION_INDEPENDENT_CODE=ON"
ENV CMAKE_PREFIX_PATH=/opt/deps
ENV PKG_CONFIG_PATH=/opt/deps/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/deps/lib
ENV CFLAGS="-fPIC"
ENV CXXFLAGS="-fPIC"

RUN dnf install -y gcc-toolset-13 hdf5-devel && dnf clean all

# TODO check if useful
RUN /opt/python/cp312-cp312/bin/pip install cmake ninja && \
    ln -sf /opt/python/cp312-cp312/bin/cmake /usr/local/bin/cmake && \
    ln -sf /opt/python/cp312-cp312/bin/ninja /usr/local/bin/ninja

WORKDIR /home

# ENV PYTHONUNBUFFERED=1
WORKDIR /home/src

RUN curl -L https://archives.boost.io/release/1.83.0/source/boost_1_83_0.tar.gz | tar xz && \
    cd /home/src/boost_1_83_0 && \
    ./bootstrap.sh --prefix=/opt/deps --without-libraries=python,mpi && \
    ./b2 -j$(nproc) cxxflags=-fPIC link=shared install && \
    rm -r /home/src/boost_1_83_0

RUN git clone -b 3.4.0 https://gitlab.com/libeigen/eigen.git && \
    mkdir -p /home/build/eigen && \
    cd /home/build/eigen && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_TESTING=OFF ../../src/eigen && \
    make -j$(nproc) && \
    make install && rm -r /home/build/eigen /home/src/eigen

RUN git clone -b 9.0.0 https://github.com/leethomason/tinyxml2.git && \
    mkdir -p /home/build/tinyxml2 && \
    cd /home/build/tinyxml2 && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF ../../src/tinyxml2 && \
    make -j$(nproc) && \
    make install && rm -r /home/build/tinyxml2 /home/src/tinyxml2

RUN git clone -b v2.1 https://github.com/danfis/libccd.git && \
    mkdir -p /home/build/libccd && \
    cd /home/build/libccd && \
    cmake $CMAKE_COMMON -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE:STRING=Release -DENABLE_DOUBLE_PRECISION=ON -DBUILD_SHARED_LIBS=ON ../../src/libccd && \
    make -j$(nproc) && \
    make install && rm -r /home/build/libccd /home/src/libccd

#-DCMAKE_CXX_FLAGS="-fPIC -Wno-error=template-id-cdtor"

RUN git clone -b v1.9.8 https://github.com/OctoMap/octomap.git && \
    mkdir -p /home/build/octomap && \
    cd /home/build/octomap && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release \
      -DBUILD_OCTOVIS_SUBPROJECT=OFF -DBUILD_DYNAMICETD3D_SUBPROJECT=OFF \
      -DCMAKE_CXX_FLAGS="-fPIC" \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      ../../src/octomap && \
    make -j$(nproc) && \
    make install && rm -r /home/build/octomap /home/src/octomap

RUN git clone -b v5.2.5 https://github.com/assimp/assimp.git && \
    mkdir -p /home/build/assimp && \
    cd /home/build/assimp && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release -DASSIMP_BUILD_TESTS=OFF -DASSIMP_WARNINGS_AS_ERRORS=OFF ../../src/assimp && \
    make -j$(nproc) && \
    make install && rm -r /home/build/assimp /home/src/assimp

RUN git clone -b 1.0.2 https://github.com/ros/console_bridge.git && \
    mkdir -p /home/build/console_bridge && \
    cd /home/build/console_bridge && \
    cmake $CMAKE_COMMON -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE:STRING=Release ../../src/console_bridge && \
    make -j$(nproc) && \
    make install && rm -r /home/build/console_bridge /home/src/console_bridge

# was: 1.0.5
RUN git clone -b 1.1.3   https://github.com/ros/urdfdom_headers.git && \
    mkdir -p /home/build/urdfdom_headers && \
    cd /home/build/urdfdom_headers && \
    cmake $CMAKE_COMMON -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE:STRING=Release ../../src/urdfdom_headers && \
    make -j$(nproc) && \
    make install && rm -r /home/build/urdfdom_headers /home/src/urdfdom_headers

# was: 1.0.4
# was: 4.0.3
RUN git clone -b 4.0.0 https://github.com/ros/urdfdom.git && \
    mkdir -p /home/build/urdfdom && \
    cd /home/build/urdfdom && \
    cmake $CMAKE_COMMON -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_TESTING=OFF ../../src/urdfdom && \
    make -j$(nproc) && \
    make install && rm -r /home/build/urdfdom /home/src/urdfdom

RUN git clone -b devel https://github.com/coal-library/coal.git && \
    cd /home/src/coal && \
    git checkout 9856e007971225d6948a8feff6da5b36cc6beacd && \
    git submodule init && \
    git submodule update && \
    mkdir -p /home/build/coal && \
    cd /home/build/coal && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_PYTHON_INTERFACE=OFF -DBUILD_TESTING=OFF -DBUILD_DOCUMENTATION=OFF ../../src/coal && \
    make -j$(nproc) && \
    make install && rm -r /home/build/coal /home/src/coal

# this version allows still to use aligned_vector
RUN git clone -b devel https://github.com/stack-of-tasks/pinocchio.git && \
    cd /home/src/pinocchio && \
    git checkout 4b2ed738b8342c6820ac12597ef2b3e32ddddd97 && \
    git submodule init && \
    git submodule update && \
    mkdir -p /home/build/pinocchio && \
    cd /home/build/pinocchio && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_WITH_URDF_SUPPORT=ON -DBUILD_WITH_COLLISION_SUPPORT=OFF -DBUILD_TESTING=FALSE -DBUILD_PYTHON_INTERFACE=OFF ../../src/pinocchio && \
    make -j4 && \
    make install && rm -r /home/build/pinocchio /home/src/pinocchio

RUN git clone https://github.com/oxfordcontrol/osqp.git && \
    cd /home/src/osqp && \
    git checkout 0b34f2ef5c5eec314e7945762e1c8167e937afbd && \
    git submodule init && \
    git submodule update && \
    mkdir -p /home/build/osqp && \
    cd /home/build/osqp && \
    cmake $CMAKE_COMMON -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DDLONG=OFF -DCMAKE_BUILD_TYPE:STRING=Release ../../src/osqp && \
    make -j$(nproc) && \
    make install && rm -r /home/build/osqp /home/src/osqp

RUN git clone https://github.com/Simple-Robotics/proxsuite.git && \
    cd /home/src/proxsuite && \
    git checkout 9f58ebd7bf42fb364de995d25679dc3f675dee7f && \
    git submodule init && \
    git submodule update && \
    mkdir -p /home/build/proxsuite && \
    cd /home/build/proxsuite && \
    cmake $CMAKE_COMMON -DBUILD_WITH_VECTORIZATION_SUPPORT=OFF -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE:STRING=Release ../../src/proxsuite && \
    make -j$(nproc) && \
    make install && rm -r /home/build/proxsuite /home/src/proxsuite

RUN git clone https://github.com/qpSWIFT/qpSWIFT.git && \
    cd /home/src/qpSWIFT && \
    git checkout 24608b671d0e7ecde4d14ee8530d1656d6940fd1 && \
    mkdir -p /home/build/qpSWIFT && \
    cd /home/build/qpSWIFT && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release ../../src/qpSWIFT && \
    make -j$(nproc) && \
    make install && rm -r /home/build/qpSWIFT /home/src/qpSWIFT

RUN git clone https://gitlab.inria.fr/rochelol/srdfdom-no-ros.git && \
    cd srdfdom-no-ros && \
    mkdir -p /home/build/srdfdom && \
    cd /home/build/srdfdom && \
    cmake $CMAKE_COMMON -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_TESTING=OFF -DTinyXML2_DIR=/opt/deps/lib/cmake/tinyxml2 ../../src/srdfdom-no-ros && \
    make -j$(nproc) && \
    make install

RUN git clone -b devel https://github.com/hucebot/xbot2_interface.git && \
    cd xbot2_interface && \
    git checkout pip_packaging && \
    mkdir -p /home/build/xbot2_interface && \
    cd /home/build/xbot2_interface && \
    cmake $CMAKE_COMMON -DCMAKE_SHARED_LINKER_FLAGS="-ldl" -DCMAKE_EXE_LINKER_FLAGS="-ldl" -DXBOT2_IFC_BUILD_TESTS=OFF -DXBOT2_IFC_BUILD_ROS=OFF -DXBOT2_IFC_BUILD_ROS2=OFF -DCMAKE_BUILD_TYPE:STRING=Release -DBoost_USE_DEBUG_RUNTIME=OFF ../../src/xbot2_interface && \
    make -j$(nproc) && \
    make install

RUN git clone -b master https://github.com/hucebot/MatLogger2.git && \
    mkdir -p /home/build/MatLogger2 && \
    cd /home/build/MatLogger2 && \
    cmake $CMAKE_COMMON -DGEN_DEB=FALSE -DCMAKE_BUILD_TYPE:STRING=Release ../../src/MatLogger2 && \
    make -j4 && \
    make install

RUN echo /opt/deps/lib > /etc/ld.so.conf.d/deps.conf
RUN ldconfig
